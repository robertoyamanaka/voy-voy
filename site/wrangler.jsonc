// Cloudflare Workers: `npm run build && npx wrangler deploy`.
// The static site is served from out/; worker.js only redirects www to the bare domain.
{
  "name": "voyvoy-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "voyvoy.sh", "custom_domain": true },
    { "pattern": "www.voyvoy.sh", "custom_domain": true }
  ]
}
